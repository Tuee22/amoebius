-- One authored package, plus the units doctrine section 2.1 admits apart:
-- probe/ solves against a deliberately perturbed project file (foreign resolution) and
-- vendor/** is not authored here (foreign provenance). Every other root that once
-- carried a package declaration is a stanza in amoebius.cabal.
packages:
  ./amoebius.cabal
  ./probe/probe.cabal

-- The compiler is an authored compatibility requirement, not a path. The range lives in
-- tools/toolchain_requirements.json and the phase gate passes the resolved compiler on the command
-- line, so no tracked file carries a developer-home path
-- (repository_layout_doctrine.md section 4).

optimization: False
tests: True

-- The infernix and jitML cores are seeds, not dependencies: amoebius links no seed package,
-- so this file declares no source-repository-package (lift_and_compose_doctrine.md section 2).
-- The lib:infernix and lib:jitml sublibraries and the suites that link them are non-buildable
-- legacy seed consumers retired by Phases 91 and 93 (LTD-SEED-001, LTD-SEED-002).
--
-- The maintained Pulsar compatibility source is Haskell under src/vendor/**. Its
-- generated Proto transport and probe package are derived lazily beneath .build/**
-- by the Phase-1 Haskell acquisition runner; top-level vendor packages are not
-- authored project inputs.
