packages:
  ./amoebius.cabal
  ./amoebius-pulsar/amoebius-pulsar.cabal
  ./amoebius-store/amoebius-store.cabal
  ./amoebius-runtime/amoebius-runtime.cabal
  ./amoebius-release/amoebius-release.cabal
  ./amoebius-pulumi/amoebius-pulumi.cabal
  ./infernix/infernix-lift.cabal
  ./infernix-ui/infernix-ui-lift.cabal
  ./jitml/jitml-lift.cabal
  ./jitml-ui/jitml-ui-lift.cabal
  ./apple-host/apple-host-lift.cabal
  ./test-topology/test-topology.cabal
  ./ui-live/ui-live.cabal
  ./offline-runtime/offline-runtime.cabal
  ./probe/probe.cabal
  ./vendor/dual/dual.cabal

-- The compiler is an authored compatibility requirement, not a path. The range lives in
-- tools/toolchain_requirements.json and the phase gate passes the resolved compiler on the command
-- line, so no tracked file carries a developer-home path
-- (repository_layout_doctrine.md section 4).

optimization: False
tests: True

allow-newer:
  supernova:base,
  supernova:bytestring,
  supernova:crc32c,
  supernova:lens-family-core,
  supernova:mtl,
  supernova:text,
  proto:base

-- A release channel, not a resolved revision: each clean run resolves the current branch head
-- and records the observed identity under .build/locks/. The compatibility patch is a tracked
-- authored input under patches/, applied into the run-local build tree only.
--
-- The gate puts the authored path-independent patch helper on PATH. The helper resolves
-- the physical checkout from its own location, so every build root may live at the canonical
-- .build/dist-newstyle/** depth. A missing helper or patch fails the checkout loudly.
source-repository-package
  type: git
  location: https://github.com/cr-org/supernova.git
  tag: master
  subdir: lib proto
  post-checkout-command: apply_supernova_patch patches/supernova_ghc_9_12.patch
