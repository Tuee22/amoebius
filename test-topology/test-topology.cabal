cabal-version: 3.12
name: test-topology
version: 0.1.0.0
build-type: Simple
license: Apache-2.0

flag phase54-skip-teardown-mutant
  default: False
  manual: True
flag phase54-tag-query-mutant
  default: False
  manual: True
flag phase54-all-tested-mutant
  default: False
  manual: True
flag phase54-wrong-subscription-mutant
  default: False
  manual: True

library
  exposed-modules:
      Amoebius.Test.Credentials
      Amoebius.Test.Harness
      Amoebius.Test.Ledger
      Amoebius.Test.ResourceWitness
      Amoebius.Test.Runner
      Amoebius.Test.SuggestTest
      Amoebius.Test.Sweep
      Amoebius.Test.Topology
  hs-source-dirs: ../src
  build-depends:
      base >=4.21 && <4.22,
      containers >=0.7 && <0.8,
      text >=2.1 && <2.2
  default-language: GHC2024
  ghc-options: -Wall -Wcompat -Werror=missing-methods -Werror=incomplete-patterns
  if flag(phase54-skip-teardown-mutant)
    cpp-options: -DPHASE54_SKIP_TEARDOWN_MUTANT
  if flag(phase54-tag-query-mutant)
    cpp-options: -DPHASE54_TAG_QUERY_MUTANT
  if flag(phase54-all-tested-mutant)
    cpp-options: -DPHASE54_ALL_TESTED_MUTANT
  if flag(phase54-wrong-subscription-mutant)
    cpp-options: -DPHASE54_WRONG_SUBSCRIPTION_MUTANT

test-suite test-topology-contract
  type: exitcode-stdio-1.0
  main-is: Phase54TestTopologyContractSpec.hs
  hs-source-dirs: ../test/topology
  build-depends:
      base >=4.21 && <4.22,
      containers >=0.7 && <0.8,
      directory >=1.3 && <1.4,
      filepath >=1.4 && <1.6,
      test-topology,
      text >=2.1 && <2.2
  default-language: GHC2024
  ghc-options: -Wall -Wcompat -Werror=missing-methods -Werror=incomplete-patterns

test-suite test-topology-live-gate
  type: exitcode-stdio-1.0
  main-is: Phase54TestTopologyLiveSpec.hs
  hs-source-dirs: ../test/live
  build-depends:
      aeson ==2.2.5.0,
      base >=4.21 && <4.22,
      bytestring >=0.12 && <0.13,
      directory >=1.3 && <1.4,
      filepath >=1.4 && <1.6,
      text >=2.1 && <2.2
  default-language: GHC2024
  ghc-options: -Wall -Wcompat -Werror=missing-methods -Werror=incomplete-patterns
