cabal-version: 3.12
name: amoebius-store
version: 0.1.0.0
build-type: Simple
license: Apache-2.0

extra-source-files:
    test/golden/manifest_canonical.cbor
    test/golden/manifest_canonical.sha256
    test/golden/manifest_noncanonical.cbor
    test/golden/write_budget_boundaries.csv

flag phase37-insertion-order-encoder-mutant
  description: Encode manifest components in caller insertion order
  default: False
  manual: True

flag phase37-orphan-free-on-pointer-conflict-mutant
  description: Credit observed orphan bytes before inventory-confirmed deletion
  default: False
  manual: True

flag phase37-orphan-budget-omitted-mutant
  description: Omit the bounded failed-write window from the store peak
  default: False
  manual: True

flag phase37-cleanup-on-job-status-mutant
  description: Delete a terminal Pod from Kubernetes status alone
  default: False
  manual: True

flag phase37-trust-gateway-ack-mutant
  description: Trust the completion gateway acknowledgement without readback
  default: False
  manual: True

library
  exposed-modules:
      Amoebius.Store.Budget
      Amoebius.Store.ContentAddress
      Amoebius.Store.ControlPlaneState
      Amoebius.Store.Manifest
      Amoebius.Store.Pointer
  hs-source-dirs:
      src
  build-depends:
      base >=4.21 && <4.22,
      bytestring >=0.12 && <0.13,
      cborg ==0.2.10.0,
      containers >=0.7 && <0.8,
      cryptohash-sha256 ==0.11.102.1,
      text >=2.1 && <2.2
  default-language: GHC2024
  ghc-options: -Wall -Wcompat -Werror=missing-methods -Werror=incomplete-patterns -Werror=incomplete-uni-patterns
  if flag(phase37-insertion-order-encoder-mutant)
    cpp-options: -DPHASE37_INSERTION_ORDER_ENCODER_MUTANT
  if flag(phase37-orphan-free-on-pointer-conflict-mutant)
    cpp-options: -DPHASE37_ORPHAN_FREE_ON_POINTER_CONFLICT_MUTANT
  if flag(phase37-orphan-budget-omitted-mutant)
    cpp-options: -DPHASE37_ORPHAN_BUDGET_OMITTED_MUTANT
  if flag(phase37-cleanup-on-job-status-mutant)
    cpp-options: -DPHASE37_CLEANUP_ON_JOB_STATUS_MUTANT
  if flag(phase37-trust-gateway-ack-mutant)
    cpp-options: -DPHASE37_TRUST_GATEWAY_ACK_MUTANT
