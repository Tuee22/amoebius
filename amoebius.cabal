test-suite validation-pb-bootstrap-grammar-component
  type: exitcode-stdio-1.0
  main-is: Main.hs
  other-modules:
      SelectorCli
      PbBootstrapGrammarOracle
      Amoebius.Validation.PbBootstrapGrammar
      Amoebius.Validation.PbBootstrapGrammar.Internal
      Amoebius.Validation.Types
  hs-source-dirs:
      test/validation-kernel/pb-bootstrap-grammar
      test/validation-kernel
      src/validation-kernel
  build-depends:
      base >=4.21 && <4.22,
      bytestring >=0.12 && <0.13,
      containers >=0.7 && <0.8,
      cryptohash-sha256 ==0.11.102.1,
      crypton ==1.0.6,
      directory >=1.3 && <1.4,
      filepath >=1.5 && <1.6,
      process >=1.6 && <1.7,
      text >=2.1 && <2.2,
      time >=1.14 && <1.15
  if !os(windows)
    build-depends:
        unix >=2.8.6 && <2.9
  default-language: GHC2024
  ghc-options: -Wall -Wcompat -Werror=missing-methods -Werror=incomplete-patterns -Werror=incomplete-uni-patterns
  if flag(validation-pb-grammar-adapter-count-bypass-mutant)
