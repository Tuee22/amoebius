executable amoebius
  main-is: Main.hs
  -- Amoebius.Ui.Server.Main is the serve-ui entry point: it is reached only through
  -- app/amoebius/Main.hs's subcommand table and belongs to the executable, not to the shared
  -- decision core. Keeping it in lib:dsl-core made every phase that links the core depend
  -- on the Phase-22 UI-server boundary, which is the forward dependency
  -- development_plan_standards.md section E forbids.
  --
  -- It lives under app/amoebius/ rather than src/ because hs-source-dirs is a search path, not a
  -- module filter: listing src here made GHC recompile every module app/amoebius/Main.hs imports
  -- from source into this component instead of linking lib:dsl-core, against this
  -- component's much shorter build-depends. That is why exe:amoebius failed on
  -- Amoebius.Vault.SecretRef -- a module this executable never mentions -- and it would
  -- have put two separately compiled copies of the shared core in one program.
  other-modules:
      Amoebius.Ui.Server.Main
  hs-source-dirs:
      app/amoebius
  build-depends:
      base >=4.21 && <4.22,
      amoebius:formal-model,
      amoebius:dsl-core,
      aeson ==2.2.5.0,
      base64-bytestring ==1.2.1.0,
      bytestring >=0.12 && <0.13,
      containers >=0.7 && <0.8,
      crypton ==1.0.6,
      memory ==0.18.0,
      network ==3.1.4.0,
      text >=2.1 && <2.2
  default-language: GHC2024
  ghc-options: -Wall -Wcompat -Werror=missing-methods -threaded

