common validation-public-selector-suite
  hs-source-dirs:
      test/validation-kernel
  build-depends:
      base >=4.21 && <4.22,
      amoebius:validation-kernel,
      bytestring >=0.12 && <0.13,
      containers >=0.7 && <0.8,
      crypton ==1.0.6,
      directory >=1.3 && <1.4,
      filepath >=1.5 && <1.6,
      memory ==0.18.0,
      process >=1.6 && <1.7,
      temporary >=1.3 && <1.4,
      text >=2.1 && <2.2
  if !os(windows)
    build-depends:
        unix >=2.8.6 && <2.9
  default-language: GHC2024
  ghc-options: -Wall -Wcompat -Werror=missing-methods -Werror=incomplete-patterns -Werror=incomplete-uni-patterns

