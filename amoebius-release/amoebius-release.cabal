cabal-version: 3.12
name: amoebius-release
version: 0.1.0.0
build-type: Simple
license: Apache-2.0

flag phase39-hash-omits-substrate-mutant
  description: Omit the substrate fingerprint from releaseHash
  default: False
  manual: True

flag phase39-blind-put-mutant
  description: Replace environment ETag-CAS with a blind pointer write
  default: False
  manual: True

flag phase39-gate-admits-unverified-mutant
  description: Admit a promotion without the required EvidenceWitness
  default: False
  manual: True

flag phase39-rollout-reorders-retire-mutant
  description: Move finalize/retire-old before verified migration
  default: False
  manual: True

flag phase39-phase-gate-selfreport-mutant
  description: Accept a phase self-report in place of a live readiness observation
  default: False
  manual: True

flag phase39-scalar-migration-peak-mutant
  description: Replace structural migration provision with a caller scalar
  default: False
  manual: True

flag phase39-drop-old-schema-on-failure-mutant
  description: Omit old schema residency from a failed migration
  default: False
  manual: True

flag phase39-drop-verification-wal-mutant
  description: Omit verification WAL from migration provision
  default: False
  manual: True

library
  exposed-modules:
      Amoebius.Release.Environment
      Amoebius.Release.EvidenceWitness
      Amoebius.Release.Ledger
      Amoebius.Release.Promote
      Amoebius.Release.PromotionGate
      Amoebius.Release.ReleaseHash
      Amoebius.Release.RolloutPlan
      Amoebius.Release.SchemaMigration
  hs-source-dirs:
      src
  build-depends:
      base >=4.21 && <4.22,
      amoebius-store,
      bytestring >=0.12 && <0.13,
      containers >=0.7 && <0.8,
      text >=2.1 && <2.2
  default-language: GHC2024
  ghc-options: -Wall -Wcompat -Werror=missing-methods -Werror=incomplete-patterns -Werror=incomplete-uni-patterns
  if flag(phase39-hash-omits-substrate-mutant)
    cpp-options: -DPHASE39_HASH_OMITS_SUBSTRATE_MUTANT
  if flag(phase39-blind-put-mutant)
    cpp-options: -DPHASE39_BLIND_PUT_MUTANT
  if flag(phase39-gate-admits-unverified-mutant)
    cpp-options: -DPHASE39_GATE_ADMITS_UNVERIFIED_MUTANT
  if flag(phase39-rollout-reorders-retire-mutant)
    cpp-options: -DPHASE39_ROLLOUT_REORDERS_RETIRE_MUTANT
  if flag(phase39-phase-gate-selfreport-mutant)
    cpp-options: -DPHASE39_PHASE_GATE_SELFREPORT_MUTANT
  if flag(phase39-scalar-migration-peak-mutant)
    cpp-options: -DPHASE39_SCALAR_MIGRATION_PEAK_MUTANT
  if flag(phase39-drop-old-schema-on-failure-mutant)
    cpp-options: -DPHASE39_DROP_OLD_SCHEMA_ON_FAILURE_MUTANT
  if flag(phase39-drop-verification-wal-mutant)
    cpp-options: -DPHASE39_DROP_VERIFICATION_WAL_MUTANT

test-suite release-lifecycle-live
  type: exitcode-stdio-1.0
  main-is: ReleaseLifecycleSpec.hs
  hs-source-dirs:
      test/live
  build-depends:
      base >=4.21 && <4.22,
      amoebius-release,
      aeson ==2.2.5.0,
      bytestring >=0.12 && <0.13,
      containers >=0.7 && <0.8,
      directory >=1.3 && <1.4,
      filepath >=1.5 && <1.6,
      process >=1.6 && <1.7,
      text >=2.1 && <2.2
  default-language: GHC2024
  ghc-options: -Wall -Wcompat -Werror=missing-methods -Werror=incomplete-patterns
