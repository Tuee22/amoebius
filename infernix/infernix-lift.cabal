cabal-version: 3.12
name: infernix-lift
version: 0.1.0.0
build-type: Simple
license: Apache-2.0
extra-source-files: dhall/infernix.dhall

flag phase49-drop-artifact-scope-mutant
  description: Authorize a ready artifact without comparing authenticated scope
  default: False
  manual: True

flag phase49-mint-ready-before-pointer-commit-mutant
  description: Mint a ready handle before the ready pointer is committed
  default: False
  manual: True

flag phase49-use-wallclock-seed-mutant
  description: Replace the request-derived seed with ambient run entropy
  default: False
  manual: True

flag phase49-regenerate-command-id-mutant
  description: Replace the stable command id while deriving an event
  default: False
  manual: True

library
  exposed-modules:
      Infernix.Adapter.Core
      Infernix.Adapter.Store
      Infernix.Adapter.Pulsar
      Infernix.Adapter.Secrets
      Infernix.Adapter.Engine
      Infernix.Inference.Deterministic
  other-modules:
      Infernix.Topic.Metadata
  hs-source-dirs:
      src
      ../../infernix/src
  build-depends:
      base >=4.21 && <4.22,
      amoebius:dsl-core,
      amoebius-pulsar,
      amoebius-store,
      bytestring >=0.12 && <0.13,
      containers >=0.7 && <0.8,
      serialise ==0.2.6.1,
      text >=2.1 && <2.2
  default-language: GHC2024
  ghc-options: -Wall -Wcompat -Werror=missing-methods -Werror=incomplete-patterns -Werror=incomplete-uni-patterns
  if flag(phase49-drop-artifact-scope-mutant)
    cpp-options: -DPHASE49_DROP_ARTIFACT_SCOPE_MUTANT
  if flag(phase49-mint-ready-before-pointer-commit-mutant)
    cpp-options: -DPHASE49_MINT_READY_BEFORE_POINTER_COMMIT_MUTANT
  if flag(phase49-use-wallclock-seed-mutant)
    cpp-options: -DPHASE49_USE_WALLCLOCK_SEED_MUTANT
  if flag(phase49-regenerate-command-id-mutant)
    cpp-options: -DPHASE49_REGENERATE_COMMAND_ID_MUTANT

executable phase49-native-driver
  main-is: NativeDriver.hs
  hs-source-dirs: app
  build-depends:
      base >=4.21 && <4.22,
      amoebius-pulsar,
      containers >=0.7 && <0.8,
      infernix-lift,
      text >=2.1 && <2.2
  default-language: GHC2024
  ghc-options: -Wall -Wcompat -Werror=missing-methods -Werror=incomplete-patterns

test-suite infernix-core-artifact-lift-contract
  type: exitcode-stdio-1.0
  main-is: Phase49ContractSpec.hs
  hs-source-dirs: ../test/kernel
  build-depends:
      base >=4.21 && <4.22,
      amoebius:dsl-core,
      amoebius-pulsar,
      bytestring >=0.12 && <0.13,
      infernix-lift,
      serialise ==0.2.6.1,
      text >=2.1 && <2.2
  default-language: GHC2024
  ghc-options: -Wall -Wcompat -Werror=missing-methods -Werror=incomplete-patterns

test-suite infernix-core-artifact-lift-live-gate
  type: exitcode-stdio-1.0
  main-is: Phase49InfernixArtifactLift.hs
  hs-source-dirs: ../test/live
  build-depends:
      base >=4.21 && <4.22,
      aeson ==2.2.5.0,
      bytestring >=0.12 && <0.13,
      text >=2.1 && <2.2,
      vector >=0.13 && <0.14
  default-language: GHC2024
  ghc-options: -Wall -Wcompat -Werror=missing-methods -Werror=incomplete-patterns
