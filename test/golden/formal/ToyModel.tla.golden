---- MODULE ToyModel ----
\* GENERATED by amoebius dev model from Model ToyModel; do not edit by hand.
EXTENDS Integers, FiniteSets, TLC

CONSTANTS Proc
VARIABLES pc, mirror, criticalCount
vars == <<pc, mirror, criticalCount>>

Init ==
  /\ pc = [p \in Proc |-> "idle"]
  /\ mirror = [p \in Proc |-> "idle"]
  /\ criticalCount = 0

Request(p) ==
  /\ (p \in Proc)
  /\ (pc[p] = "idle")
  /\ pc' = [pc EXCEPT ![p] = "want"]
  /\ mirror' = [mirror EXCEPT ![p] = "want"]
  /\ UNCHANGED <<criticalCount>>

Enter(p) ==
  /\ (p \in Proc)
  /\ (pc[p] = "want")
  /\ (\A q \in Proc : ((q = p) \/ (pc[q] # "critical")))
  /\ pc' = [pc EXCEPT ![p] = "critical"]
  /\ mirror' = [mirror EXCEPT ![p] = "critical"]
  /\ criticalCount' = 1

Exit(p) ==
  /\ (p \in Proc)
  /\ (pc[p] = "critical")
  /\ pc' = [pc EXCEPT ![p] = "idle"]
  /\ mirror' = [mirror EXCEPT ![p] = "idle"]
  /\ criticalCount' = 0

Next ==
  \/ (\E p \in Proc : Request(p))
  \/ (\E p \in Proc : Enter(p))
  \/ (\E p \in Proc : Exit(p))

MutualExclusion ==
  /\ (\A p \in Proc : (\A q \in Proc : ((p = q) \/ ((pc[p] # "critical") \/ (pc[q] # "critical")))))
  /\ (pc = mirror)
  /\ (0 <= criticalCount)
  /\ (criticalCount <= 1)
  /\ (((criticalCount = 0) /\ (\A p \in Proc : (pc[p] # "critical"))) \/ ((criticalCount = 1) /\ (\E p \in Proc : (pc[p] = "critical"))))

StateBound ==
  /\ TRUE
  /\ (\A p \in Proc : (pc[p] \in {"idle", "want", "critical"}))
  /\ (\A p \in Proc : (mirror[p] \in {"idle", "want", "critical"}))

Spec ==
  /\ Init
  /\ [][Next]_vars
  /\ (\A p \in Proc : WF_vars(Request(p)))
  /\ (\A p \in Proc : SF_vars(Enter(p)))
  /\ (\A p \in Proc : WF_vars(Exit(p)))

EveryRequestEventuallyExits == ((\E p \in Proc : (pc[p] = "critical")) ~> (\A p \in Proc : (pc[p] # "critical")))
AlwaysMutualExclusion == [](MutualExclusion)
SomeProcessEventuallyCritical == <>(\E p \in Proc : (pc[p] = "critical"))

