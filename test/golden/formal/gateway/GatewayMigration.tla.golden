  /\ (targetLog \in {0, 1, 2})
  /\ (divergence \in {0, 1, 2})
  /\ (\A flag \in {sourceOwns, targetOwns, sourceUp, targetUp, liveSession, rebindable, quiesced, caughtUp, freshnessWitness, coldSeeded, rebound, drainComplete, healed} : (flag \in {FALSE, TRUE}))

