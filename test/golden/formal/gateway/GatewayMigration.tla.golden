MergeConverges == ((branch = "failover") ~> (((IF sourceOwns THEN 1 ELSE 0) + (IF targetOwns THEN 1 ELSE 0)) = 1))
SessionEventuallyRebinds == ((branch = "failover") ~> rebound)
PlannedMigrationTerminates == ((branch = "planned") ~> ((phase = "Done") \/ (phase = "StandDown") \/ (branch = "none")))

