  "nativeEncodingUpperBound": {
    "maximumDistinctRecords": 5724,
    "maximumCanonicalBytesDigits": 6,
    "maximumZxidDigits": 19,
    "maximumRecordJsonBytes": 137,
    "maximumRecordSeparatingCommas": 5723,
    "maximumFixedStateJsonBytesWithEmptyRecordArray": 921,
    "maximumRawPayloadBytes": 790832,
    "maximumEnvelopeBytes": 71,
    "maximumTotalStateBytes": 790903,
    "slackBelow1MiB": 257673,
    "scope": "Conservative upper bound for exact native policy only; deliberately combines individually worst widths even though they cannot all coexist. No subject serialization sizes supply these literals."
  },
  "powerLossScope": {
    "beforeCandidateRenameAllowedStates": [
      "acknowledged"
    ],
    "afterRenameBeforeDirectorySyncAllowedStates": [
      "acknowledged",
      "next-unacknowledged"
    ],
    "afterDirectorySyncAllowedStates": [
      "next-unacknowledged"
    ],
    "afterAcknowledgedReturnMustRetainState": "next-unacknowledged",
    "warning": "Process exceptions/SIGKILL test visible process-restart behavior, not an actual host/device power cut. The faultCases use deterministic visible old/new states after a completed stage; only this separate durability argument permits both states at an uncertain power-loss rename boundary."
  },
  "requiredIntegrationPremises": [
    "Exclusive initialization durably publishes the new subdirectory by syncing its parent; no resume/init fallback or state reset.",
    "Lifetime owner.lock is never unlinked/replaced during ownership; separate open file descriptions use flock/OFD exclusion, including same-process second handles. Lock inheritance in child tests is explicit.",
    "Only a validated matching current can authorize stale candidate cleanup. Never load a candidate as current fallback. No symlink/hardlink/FIFO/directory alias may be truncated or used.",
    "Native encoding bound depends on exact native policy and fixed schema; larger policies still fail closed at the total-file limit. No expectation that arbitrary1MiB bytes constitute valid state.",
    "Checksums detect corruption; they do not authenticate replay of an older well-formed prefix or authorize importing/resetting an old backing. Durable grants/no rollback and trusted filesystem lineage remain required.",
    "Store files/current+candidate, lock/directory blocks, journals/control reserve and incoming/failed generations still need concrete capacity/execution allocation."
  ]
}
