    {
      "id": "state-serialization-cannot-relabel-origin-policy",
      "originPolicy": "wide",
      "seedReservations": [
        "global-exact",
        "session"
      ],
      "operation": "serialize-then-decode",
      "serializePolicy": "native",
      "decodePolicy": "native",
      "expectedAdmission": "deny",
      "expectedReason": "retained-policy-mismatch",
