{
  "schema": "phase30.independent.execution-pod-invariant.v1",
  "provenance": "Independently chosen tiny structural operands and controller counts, authored before core repair. No subject outputs and no CPU/memory/runtime adequacy claims.",
  "rule": "Each actually emitted Kubernetes Deployment/StatefulSet/DaemonSet/Job instance reserves at least one pod slot. HostProcess may reserve0. Empty expansion may reserve0.",
  "cases": [
    {
      "id": "deployment-zero-pod-denied",
      "input": {
        "transition": "FirstDeployment",
        "units": [
          {
            "id": "test/deployment",
            "revision": 1,
            "body": {
              "kind": "Deployment",
              "replicas": 2,
              "rollout": "Recreate"
            },
            "envelope": {
              "requests": {
                "cpuMillis": 1,
                "memoryBytes": 1,
                "ephemeralBytes": 1,
                "podSlots": 0
              },
              "limits": {
                "cpuMillis": 1,
                "memoryBytes": 1,
                "ephemeralBytes": 1,
                "podSlots": 0
              },
              "headroom": {
                "cpuMillis": 0,
                "memoryBytes": 0,
                "ephemeralBytes": 0,
                "podSlots": 0
              }
            }
          }
        ],
        "available": {
          "cpuMillis": 2,
          "memoryBytes": 2,
          "ephemeralBytes": 2,
          "podSlots": 2
        }
      },
      "expected": "reject",
      "expectedEmittedInstances": 2,
      "expectedPeak": null,
      "basis": "Every emitted Kubernetes instance is one real pod. Ample supply prevents a shortage from masking a malformed zero-charge declaration."
    },
