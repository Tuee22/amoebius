cabal-version: 3.12
name: amoebius-pulsar
version: 0.1.0.0
build-type: Custom
license: Apache-2.0
extra-source-files:
    proto/Amoebius/Pulsar/Proto/PulsarApi.proto

custom-setup
  setup-depends:
      base >=4.21 && <4.22,
      Cabal >=3.14 && <3.15,
      directory >=1.3 && <1.4,
      filepath >=1.5 && <1.6,
      proto-lens-setup >=0.4 && <0.5

flag phase35-topic-literal-mutant
  description: Replace derived topics with a literal topic
  default: False
  manual: True

flag phase35-drop-one-sided-mutant
  description: Delete the one-sided-link topology clause
  default: False
  manual: True

flag phase35-produce-raw-mutant
  description: Re-add an exported raw ByteString producer arm
  default: False
  manual: True

library
  exposed-modules:
      Amoebius.Pulsar.Cbor
      Amoebius.Pulsar.Connection
      Amoebius.Pulsar.Consumer
      Amoebius.Pulsar.Dedup
      Amoebius.Pulsar.Frame
      Amoebius.Pulsar.Namespace
      Amoebius.Pulsar.Producer
      Amoebius.Pulsar.Provision
      Amoebius.Pulsar.Seek
      Amoebius.Pulsar.Subscription
      Amoebius.Pulsar.Topology
  other-modules:
      Amoebius.Pulsar.Internal.Cbor
      Amoebius.Pulsar.Internal.Frame
      Amoebius.Pulsar.Internal.Protocol
      Amoebius.Pulsar.Internal.Types
      Proto.PulsarApi
      Proto.PulsarApi_Fields
  autogen-modules:
      Proto.PulsarApi
      Proto.PulsarApi_Fields
  hs-source-dirs:
      src
      proto
  build-depends:
      base >=4.21 && <4.22,
      binary >=0.8 && <0.9,
      bytestring >=0.12 && <0.13,
      containers >=0.7 && <0.8,
      crc32c ==0.2.2,
      lens-family-core >=2.1 && <2.2,
      network ==3.1.4.0,
      proto-lens >=0.7 && <0.8,
      proto-lens-runtime >=0.7 && <0.8,
      serialise ==0.2.6.1,
      text >=2.1 && <2.2,
      time >=1.12 && <1.15
  build-tool-depends:
      proto-lens-protoc:proto-lens-protoc >=0.9 && <0.10
  default-language: GHC2024
  ghc-options: -Wall -Wcompat -Werror=missing-methods -Werror=incomplete-patterns -Werror=incomplete-uni-patterns
  if flag(phase35-topic-literal-mutant)
    cpp-options: -DPHASE35_TOPIC_LITERAL_MUTANT
  if flag(phase35-drop-one-sided-mutant)
    cpp-options: -DPHASE35_DROP_ONE_SIDED_MUTANT
  if flag(phase35-produce-raw-mutant)
    cpp-options: -DPHASE35_PRODUCE_RAW_MUTANT

test-suite pulsar-client-live
  type: exitcode-stdio-1.0
  main-is: PulsarClientLiveSpec.hs
  hs-source-dirs:
      test
  build-depends:
      base >=4.21 && <4.22,
      aeson ==2.2.5.0,
      amoebius-pulsar,
      bytestring >=0.12 && <0.13,
      containers >=0.7 && <0.8,
      directory >=1.3 && <1.4,
      filepath >=1.5 && <1.6,
      process >=1.6 && <1.7,
      serialise ==0.2.6.1,
      text >=2.1 && <2.2
  default-language: GHC2024
  ghc-options: -Wall -Wcompat -Werror=missing-methods -Werror=incomplete-patterns

test-suite pulsar-dedup-sim
  type: exitcode-stdio-1.0
  main-is: PulsarDedupSimSpec.hs
  hs-source-dirs:
      test
  build-depends:
      base >=4.21 && <4.22,
      amoebius-pulsar,
      containers >=0.7 && <0.8,
      text >=2.1 && <2.2
  default-language: GHC2024
  ghc-options: -Wall -Wcompat -Werror=missing-methods -Werror=incomplete-patterns
