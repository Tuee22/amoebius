#!/usr/bin/env python3
"""Run the sim probe and compare stdout with the independent terminal oracle.

The expected terminal state is authored in `probe/fixtures/sim-terminal.expected` and is
not derived from the probe's output. The toolchain this oracle drives is supplied by the
caller: the resolved compiler and `cabal` are run-local observations
(`.build/toolchain/resolved.json`), and a tracked file that named either of them would be
carrying resolver output (`repository_layout_doctrine.md` section 4).
"""

from __future__ import annotations

import argparse
import subprocess
import sys
from pathlib import Path


ROOT = Path(__file__).resolve().parents[2]


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--perturbed", action="store_true")
    parser.add_argument("--cabal", required=True, help="the resolved cabal executable")
    parser.add_argument("--with-compiler", required=True, help="the resolved compiler executable")
    parser.add_argument("--builddir", required=True)
    parser.add_argument("--store-dir", required=True)
    args = parser.parse_args()
    command = [
        args.cabal,
        f"--with-compiler={getattr(args, 'with_compiler')}",
        "-v0",
        f"--builddir={args.builddir}",
        f"--store-dir={args.store_dir}",
        "run",
        "probe:sim",
        "--",
    ]
    if args.perturbed:
        command.append("--perturbed")
    result = subprocess.run(command, cwd=ROOT, text=True, capture_output=True, check=False)
    if result.returncode != 0:
        sys.stderr.write(result.stdout + result.stderr)
        return result.returncode
    expected = (ROOT / "probe/fixtures/sim-terminal.expected").read_text(encoding="utf-8")
    if result.stdout != expected:
        sys.stderr.write("terminal-state mismatch\n")
        sys.stderr.write(f"expected: {expected!r}\nactual:   {result.stdout!r}\n")
        return 1
    sys.stdout.write(result.stdout)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
