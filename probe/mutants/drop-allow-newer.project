-- Seeded mutant: dependency-resolution removal.
--
-- This project is a sibling of `cabal.project` that differs in exactly one dimension: the
-- `allow-newer` stanza is deleted. Everything else — the package list, the source
-- repository, the compatibility patch, the build settings — is identical, so the red
-- result is attributable to that single edit and to nothing else
-- (`development_plan_standards.md` section M clauses 2 and 8).
--
-- An earlier revision listed a package set that had drifted from `cabal.project`. That made
-- the solver fail at an unknown sibling package before it ever reached the intended
-- `proto`/`base` conflict, which is a mutant that turns the gate red for the wrong reason —
-- indistinguishable, from the gate's side, from one that works. Everything below therefore
-- tracks `cabal.project` exactly: the same three packages and the same three
-- source-repository-packages, because `amoebius.cabal` depends on the infernix and jitML
-- cores and a solver that cannot find them never reaches the seeded conflict at all.

packages:
  ./amoebius.cabal
  ./probe/probe.cabal
  ./vendor/dual/dual.cabal

optimization: False
tests: True

source-repository-package
  type: git
  location: https://github.com/cr-org/supernova.git
  tag: master
  subdir: lib proto
  post-checkout-command: apply_supernova_patch patches/supernova_ghc_9_12.patch

source-repository-package
  type: git
  location: https://github.com/Tuee22/infernix.git
  tag: master

source-repository-package
  type: git
  location: https://github.com/Tuee22/jitML.git
  tag: master
