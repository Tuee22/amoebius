cabal-version: 3.12
name: jitml-lift
version: 0.1.0.0
build-type: Simple
license: Apache-2.0
extra-source-files: ../dhall/jitml/package.dhall

flag phase51-silent-cpu-fallback-mutant
  default: False
  manual: True

flag phase51-spend-raw-vram-mutant
  default: False
  manual: True

flag phase51-mint-artifact-before-cas-mutant
  default: False
  manual: True

flag phase51-regenerate-command-id-mutant
  default: False
  manual: True

library
  exposed-modules:
      Amoebius.JitML.CudaArtifactLift
      JitML.Codegen.RuntimeOperationsCuda
  other-modules:
      JitML.Cache.Key
      JitML.Codegen.SourceFile
  hs-source-dirs:
      src
      ../../jitML/src
  build-depends:
      aeson ==2.2.5.0,
      amoebius-store,
      base >=4.21 && <4.22,
      bytestring >=0.12 && <0.13,
      containers >=0.7 && <0.8,
      cryptohash-sha256 ==0.11.102.1,
      serialise ==0.2.6.1,
      text >=2.1 && <2.2
  default-language: GHC2024
  ghc-options: -Wall -Wcompat -Werror=missing-methods -Werror=incomplete-patterns -Werror=incomplete-uni-patterns
  if flag(phase51-silent-cpu-fallback-mutant)
    cpp-options: -DPHASE51_SILENT_CPU_FALLBACK_MUTANT
  if flag(phase51-spend-raw-vram-mutant)
    cpp-options: -DPHASE51_SPEND_RAW_VRAM_MUTANT
  if flag(phase51-mint-artifact-before-cas-mutant)
    cpp-options: -DPHASE51_MINT_ARTIFACT_BEFORE_CAS_MUTANT
  if flag(phase51-regenerate-command-id-mutant)
    cpp-options: -DPHASE51_REGENERATE_COMMAND_ID_MUTANT

test-suite jitml-cuda-artifact-lift-contract
  type: exitcode-stdio-1.0
  main-is: Phase51JitMLCudaArtifactContractSpec.hs
  hs-source-dirs: ../test/kernel
  build-depends:
      base >=4.21 && <4.22,
      bytestring >=0.12 && <0.13,
      directory >=1.3 && <1.4,
      filepath >=1.4 && <1.6,
      jitml-lift,
      text >=2.1 && <2.2
  default-language: GHC2024
  ghc-options: -Wall -Wcompat -Werror=missing-methods -Werror=incomplete-patterns

test-suite jitml-cuda-artifact-lift-live-gate
  type: exitcode-stdio-1.0
  main-is: Phase51JitMLCudaArtifactLift.hs
  hs-source-dirs: ../test/live
  build-depends:
      aeson ==2.2.5.0,
      base >=4.21 && <4.22,
      bytestring >=0.12 && <0.13,
      directory >=1.3 && <1.4,
      filepath >=1.4 && <1.6,
      text >=2.1 && <2.2,
      vector >=0.13 && <0.14
  default-language: GHC2024
  ghc-options: -Wall -Wcompat -Werror=missing-methods -Werror=incomplete-patterns
