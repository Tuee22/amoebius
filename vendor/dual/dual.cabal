cabal-version: 3.12
name: dual
version: 0.1.1.2
synopsis: Dual category, patched for GHC 9.12 quantified superclasses
license: BSD-3-Clause
build-type: Simple

library
  exposed-modules:
      Control.Category.Dual
      Data.Bifunctor.Flip
  hs-source-dirs: src
  build-depends: base >=4.21 && <4.22
  default-language: GHC2024
  ghc-options: -Wall -Werror=missing-methods
