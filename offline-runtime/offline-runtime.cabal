  if flag(phase64-fault-one-pod-mutant)
    cpp-options: -DPHASE64_FAULT_ONE_POD_MUTANT
  if flag(phase64-sticky-routing-mutant)
    cpp-options: -DPHASE64_STICKY_ROUTING_MUTANT
  if flag(phase64-redis-receipt-mutant)
    cpp-options: -DPHASE64_REDIS_RECEIPT_MUTANT
  if flag(phase64-skip-cursor-repair-mutant)
    cpp-options: -DPHASE64_SKIP_CURSOR_REPAIR_MUTANT
  if flag(phase64-prefault-authority-mutant)
