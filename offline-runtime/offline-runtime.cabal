  if flag(phase61-ack-redis-publish-mutant)
    cpp-options: -DPHASE61_ACK_REDIS_PUBLISH_MUTANT
  if flag(phase61-omit-durable-lookup-mutant)
    cpp-options: -DPHASE61_OMIT_DURABLE_LOOKUP_MUTANT
  if flag(phase61-drop-membership-validation-mutant)
    cpp-options: -DPHASE61_DROP_MEMBERSHIP_VALIDATION_MUTANT
  if flag(phase61-two-tab-replay-mutant)
    cpp-options: -DPHASE61_TWO_TAB_REPLAY_MUTANT
  if flag(phase61-discard-pending-disconnect-mutant)
    cpp-options: -DPHASE61_DISCARD_PENDING_DISCONNECT_MUTANT
  if flag(phase61-remove-scope-idempotency-mutant)
    cpp-options: -DPHASE61_REMOVE_SCOPE_IDEMPOTENCY_MUTANT
  if flag(phase62-store-plaintext-mutant)
    cpp-options: -DPHASE62_STORE_PLAINTEXT_MUTANT
  if flag(phase62-expose-opfs-handle-mutant)
    cpp-options: -DPHASE62_EXPOSE_OPFS_HANDLE_MUTANT
  if flag(phase62-omit-partition-scope-mutant)
