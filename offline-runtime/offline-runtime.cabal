  if flag(phase62-replay-before-verification-mutant)
    cpp-options: -DPHASE62_REPLAY_BEFORE_VERIFICATION_MUTANT
  if flag(phase62-silent-blob-eviction-mutant)
    cpp-options: -DPHASE62_SILENT_BLOB_EVICTION_MUTANT
  if flag(phase62-trust-caller-digest-mutant)
    cpp-options: -DPHASE62_TRUST_CALLER_DIGEST_MUTANT
  if flag(phase63-clear-state-reload-mutant)
    cpp-options: -DPHASE63_CLEAR_STATE_RELOAD_MUTANT
  if flag(phase63-omit-old-decoder-mutant)
    cpp-options: -DPHASE63_OMIT_OLD_DECODER_MUTANT
  if flag(phase63-bypass-promotion-check-mutant)
