test-suite offline-plan-spec
  type: exitcode-stdio-1.0
  main-is: OfflinePlanSpec.hs
  hs-source-dirs: ../test/Ui
  build-depends:
      base >=4.21 && <4.22,
      directory >=1.3 && <1.4,
      filepath >=1.4 && <1.6,
      offline-runtime,
      text >=2.1 && <2.2
  default-language: GHC2024
  ghc-options: -Wall -Wcompat -Werror=missing-methods -Werror=incomplete-patterns

