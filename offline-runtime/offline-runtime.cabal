library
  exposed-modules:
      Amoebius.Ui.Offline.Browser.Crypto
      Amoebius.Ui.Offline.Browser.Leader
      Amoebius.Ui.Offline.Browser.Partition
      Amoebius.Ui.Offline.Browser.ServiceWorker
      Amoebius.Ui.Offline.Browser.Store
      Amoebius.Ui.Offline.BlobUpload
      Amoebius.Ui.Offline.Decode
      Amoebius.Ui.Offline.Plan
      Amoebius.Ui.Offline.Outcome
      Amoebius.Ui.Offline.Receipt
      Amoebius.Ui.Offline.Replay
      Amoebius.Ui.Offline.Ha.MultiZone
      Amoebius.Ui.Offline.Types
      Amoebius.Release.OfflineCompatibility
  hs-source-dirs: ../src
  build-depends:
      base >=4.21 && <4.22,
      containers >=0.7 && <0.8
  default-language: GHC2024
  ghc-options: -Wall -Wcompat -Werror=missing-methods -Werror=incomplete-patterns
  if flag(phase59-drop-queue-bound-mutant)
    cpp-options: -DPHASE59_DROP_QUEUE_BOUND_MUTANT
  if flag(phase59-omit-server-handler-mutant)
    cpp-options: -DPHASE59_OMIT_SERVER_HANDLER_MUTANT
  if flag(phase59-queue-model-invocation-mutant)
    cpp-options: -DPHASE59_QUEUE_MODEL_INVOCATION_MUTANT
  if flag(phase59-persist-private-field-mutant)
    cpp-options: -DPHASE59_PERSIST_PRIVATE_FIELD_MUTANT
  if flag(phase59-browser-redis-constructor-mutant)
    cpp-options: -DPHASE59_BROWSER_REDIS_CONSTRUCTOR_MUTANT
  if flag(phase60-store-plaintext-mutant)
    cpp-options: -DPHASE60_STORE_PLAINTEXT_MUTANT
  if flag(phase60-retain-credentials-mutant)
    cpp-options: -DPHASE60_RETAIN_CREDENTIALS_MUTANT
  if flag(phase60-two-replay-leaders-mutant)
    cpp-options: -DPHASE60_TWO_REPLAY_LEADERS_MUTANT
  if flag(phase60-omit-fencing-mutant)
    cpp-options: -DPHASE60_OMIT_FENCING_MUTANT
  if flag(phase60-silent-dependency-eviction-mutant)
    cpp-options: -DPHASE60_SILENT_DEPENDENCY_EVICTION_MUTANT
  if flag(phase60-reuse-partition-key-mutant)
