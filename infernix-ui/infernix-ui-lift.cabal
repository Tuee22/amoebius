cabal-version: 3.12
name: infernix-ui-lift
version: 0.1.0.0
build-type: Simple
license: Apache-2.0
extra-source-files: ../dhall/ui/infernix.dhall

flag phase50-trust-client-artifact-scope-mutant
  description: Authorize an infernix UI artifact from the caller's scope claim
  default: False
  manual: True

flag phase50-drop-command-id-from-terminal-mutant
  description: Replace the original scoped command id in the infernix terminal receipt
  default: False
  manual: True

library
  exposed-modules:
      Amoebius.Infernix.UiAdapter
  hs-source-dirs:
      src
  build-depends:
      base >=4.21 && <4.22,
      amoebius:dsl-core,
      bytestring >=0.12 && <0.13,
      containers >=0.7 && <0.8,
      cryptohash-sha256 ==0.11.102.1,
      infernix-lift,
      text >=2.1 && <2.2
  default-language: GHC2024
  ghc-options: -Wall -Wcompat -Werror=missing-methods -Werror=incomplete-patterns
  if flag(phase50-trust-client-artifact-scope-mutant)
    cpp-options: -DPHASE50_TRUST_CLIENT_ARTIFACT_SCOPE_MUTANT
  if flag(phase50-drop-command-id-from-terminal-mutant)
    cpp-options: -DPHASE50_DROP_COMMAND_ID_FROM_TERMINAL_MUTANT

test-suite infernix-ui-lift-contract
  type: exitcode-stdio-1.0
  main-is: Phase50InfernixUiContractSpec.hs
  hs-source-dirs:
      ../test/ui
  build-depends:
      base >=4.21 && <4.22,
      amoebius:dsl-core,
      bytestring >=0.12 && <0.13,
      cryptohash-sha256 ==0.11.102.1,
      directory >=1.3 && <1.4,
      filepath >=1.5 && <1.6,
      infernix-lift,
      infernix-ui-lift,
      text >=2.1 && <2.2
  default-language: GHC2024
  ghc-options: -Wall -Wcompat -Werror=missing-methods -Werror=incomplete-patterns

test-suite infernix-ui-lift-live-gate
  type: exitcode-stdio-1.0
  main-is: Phase50InfernixUiLift.hs
  hs-source-dirs:
      ../test/live
  build-depends:
      base >=4.21 && <4.22,
      aeson ==2.2.5.0,
      bytestring >=0.12 && <0.13,
      containers >=0.7 && <0.8,
      directory >=1.3 && <1.4,
      filepath >=1.5 && <1.6,
      text >=2.1 && <2.2
  default-language: GHC2024
  ghc-options: -Wall -Wcompat -Werror=missing-methods -Werror=incomplete-patterns
